rules_version = '2';
// Plan Spark: SIN Cloud Functions. Toda la seguridad vive en estas reglas + el cliente.
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── Helpers ─────────────────────────
    function isAuth() { return request.auth != null; }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isSuperAdmin() { return isAuth() && userRole() == 'superadmin'; }
    function isCompany()    { return isAuth() && userRole() == 'company'; }
    function isOwner(uid)   { return isAuth() && request.auth.uid == uid; }

    function companyDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId));
    }
    function isCompanyOwner(companyId) {
      return isAuth() && companyDoc(companyId).data.ownerId == request.auth.uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function optString(d, key, maxLen) {
      return !(key in d) || (d[key] is string && d[key].size() <= maxLen);
    }
    function isDateKey(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    // endTime puede pasar de 24:00 si el turno termina tarde (p.ej. "24:30")
    function isHHmm(s)    { return s is string && s.matches('^[0-9]{2}:[0-5][0-9]$'); }

    // ───────────────────────── USERS ─────────────────────────
    match /users/{uid} {
      allow read:   if isOwner(uid) || isSuperAdmin();
      // acceptedTermsAt (opcional): momento en que aceptó Términos y Privacidad al registrarse (serverTimestamp)
      allow create: if isOwner(uid)
                    && request.resource.data.role in ['client', 'company']
                    && request.resource.data.get('uid', uid) == uid
                    && request.resource.data.get('isActive', true) == true
                    && request.resource.data.get('acceptedTermsAt', request.time) == request.time;
      // El dueño edita su perfil (displayName, phone, photoUrl, fcmToken, profileComplete, ...)
      // pero NUNCA role / isActive / uid. Excepción legacy: doc sin role puede fijarlo una vez.
      allow update: if isSuperAdmin() || (
        isOwner(uid)
        && !changedKeys().hasAny(['isActive', 'uid'])
        && (!changedKeys().hasAny(['acceptedTermsAt']) || request.resource.data.acceptedTermsAt == request.time)
        && (
          !changedKeys().hasAny(['role'])
          || (!('role' in resource.data) && request.resource.data.role in ['client', 'company'])
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ───────────────────────── COMPANIES ─────────────────────────
    match /companies/{companyId} {
      allow read: if resource.data.isPublic == true
                  || (isAuth() && request.auth.uid == resource.data.ownerId)
                  || isSuperAdmin();
      allow create: if isSuperAdmin()
                    || (isCompany() && request.resource.data.ownerId == request.auth.uid);
      allow update: if
        // Dueño: todo menos ownerId / isActive (lo maneja superadmin). El rating ya no se guarda acá:
        // se calcula con una agregación sobre /reviews (campos legacy bloqueados).
        (isAuth() && resource.data.ownerId == request.auth.uid
          && !changedKeys().hasAny(['ownerId', 'isActive', 'createdAt', 'averageRating', 'reviewCount']))
        || isSuperAdmin();
      allow delete: if isSuperAdmin();

      match /services/{serviceId} {
        allow read:  if true;
        allow write: if isCompanyOwner(companyId) || isSuperAdmin();
      }

      match /blockedSlots/{slotId} {
        allow read:  if true;
        allow write: if isCompanyOwner(companyId) || isSuperAdmin();
      }

      match /staff/{staffId} {
        allow read:  if true;
        allow write: if isCompanyOwner(companyId) || isSuperAdmin();
      }
    }

    // ───────────────────────── SLOT LOCKS ─────────────────────────
    // Ocupación pública SIN PII: slotLocks/{companyId}_{date}
    //   { companyId, date, entries: [{aptId, staffId|null, startTime, endTime}], updatedAt }
    // - Agregar: exactamente UNA entry al final, que debe ser una cita creada en la MISMA
    //   escritura (no existía antes, existe después) con los mismos datos de horario.
    // - Quitar: exactamente UNA entry, cuya cita queda cancelada o eliminada tras la escritura.
    // Así sólo quien puede crear/cancelar/borrar la cita puede tocar su entry.
    function aptPath(aptId) { return /databases/$(database)/documents/appointments/$(aptId); }

    function lockShapeOk(lockId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['companyId', 'date', 'entries', 'updatedAt'])
          && d.keys().hasAll(['companyId', 'date', 'entries', 'updatedAt'])
          && d.companyId is string
          && isDateKey(d.date)
          && lockId == d.companyId + '_' + d.date
          && d.entries is list
          && d.entries.size() <= 300
          && d.updatedAt == request.time;
    }

    function entryIsNewApt(e) {
      let apt = getAfter(aptPath(e.aptId)).data;
      return e is map
          && e.keys().hasOnly(['aptId', 'staffId', 'startTime', 'endTime'])
          && e.keys().hasAll(['aptId', 'staffId', 'startTime', 'endTime'])
          && e.aptId is string
          && !exists(aptPath(e.aptId))
          && apt.companyId == request.resource.data.companyId
          && apt.date == request.resource.data.date
          && apt.startTime == e.startTime
          && apt.endTime == e.endTime
          && apt.get('staffId', null) == e.staffId
          && apt.status in ['pending', 'scheduled'];
    }

    function aptReleased(aptId) {
      return !existsAfter(aptPath(aptId))
          || getAfter(aptPath(aptId)).data.status == 'cancelled';
    }

    function lockAppend() {
      let before = resource.data.entries;
      let after  = request.resource.data.entries;
      return after.size() == before.size() + 1
          && after == before.concat([after[before.size()]])
          && entryIsNewApt(after[before.size()]);
    }

    function lockRemoval() {
      let before = resource.data.entries;
      let after  = request.resource.data.entries;
      let gone   = before.removeAll(after);
      return after.size() == before.size() - 1
          && before.hasAll(after)
          && gone.size() == 1
          && aptReleased(gone[0].aptId);
    }

    match /slotLocks/{lockId} {
      allow read: if true;
      allow create: if lockShapeOk(lockId)
                    && request.resource.data.entries.size() == 1
                    && entryIsNewApt(request.resource.data.entries[0]);
      allow update: if lockShapeOk(lockId)
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.date == resource.data.date
                    && (lockAppend() || lockRemoval());
      allow delete: if isSuperAdmin();
    }

    // ───────────────────────── APPOINTMENTS ─────────────────────────
    // Lectura: SÓLO cliente dueño, dueño de la empresa o superadmin (antes: público → PII expuesta).
    // Las queries del cliente filtran clientId == uid; las de la empresa companyId == su empresa.
    function aptCreateShapeOk(d) {
      return d.keys().hasAll(['companyId', 'companyName', 'serviceId', 'serviceName', 'serviceDuration',
                              'clientName', 'clientPhone', 'isGuestClient', 'date', 'startTime',
                              'endTime', 'status', 'source', 'createdAt'])
          && d.keys().hasOnly(['companyId', 'companyName', 'serviceId', 'serviceName', 'serviceDuration',
                               'clientId', 'clientName', 'clientPhone', 'clientEmail', 'clientPhotoUrl', 'isGuestClient',
                               'date', 'startTime', 'endTime', 'price', 'clientNote', 'staffId',
                               'staffName', 'status', 'source', 'createdAt'])
          && d.companyId is string && d.companyName is string && d.companyName.size() <= 200
          && d.serviceId is string && d.serviceName is string && d.serviceName.size() <= 200
          && d.serviceDuration is number && d.serviceDuration > 0 && d.serviceDuration <= 1440
          && d.clientName is string && d.clientName.size() <= 120
          && d.clientPhone is string && d.clientPhone.size() <= 40
          && optString(d, 'clientEmail', 200)
          // Copia de la foto del cliente (data URL 150x150 o URL de Google): la empresa no puede leer users/{uid}
          && optString(d, 'clientPhotoUrl', 100000)
          && optString(d, 'clientNote', 1000)
          && optString(d, 'staffId', 128)
          && optString(d, 'staffName', 200)
          && (!('price' in d) || (d.price is number && d.price >= 0))
          && d.isGuestClient is bool
          && isDateKey(d.date) && isHHmm(d.startTime) && isHHmm(d.endTime)
          && d.startTime < d.endTime
          && d.source in ['app', 'manual']
          && d.createdAt == request.time;
    }

    // La cita debe registrarse en el lock del día en la MISMA escritura (ocupación pública consistente)
    function aptHasLock(aptId, d) {
      let lockPath = /databases/$(database)/documents/slotLocks/$(d.companyId + '_' + d.date);
      return existsAfter(lockPath)
          && {'aptId': aptId, 'staffId': d.get('staffId', null),
              'startTime': d.startTime, 'endTime': d.endTime} in getAfter(lockPath).data.entries;
    }

    // Día de la semana de 'YYYY-MM-DD' con las claves de horario de la app (dayOfWeek: 1=lunes … 7=domingo)
    function dayKeyOf(dateKey) {
      let p = dateKey.split('-');
      return ['lun', 'mar', 'mie', 'jue', 'vie', 'sab', 'dom'][
        timestamp.date(int(p[0]), int(p[1]), int(p[2])).dayOfWeek() - 1];
    }

    // Reserva con profesional elegido: debe estar activo, hacer ese servicio y trabajar en ese horario.
    // Sin horario propio (schedule vacío) usa el de la empresa.
    function aptStaffOk(d) {
      let staffPath = /databases/$(database)/documents/companies/$(d.companyId)/staff/$(d.staffId);
      let staff = get(staffPath).data;
      let sched = staff.get('schedule', {});
      let day = sched.get(dayKeyOf(d.date), null);
      return exists(staffPath)
          && staff.get('isActive', false) == true
          && d.serviceId in staff.get('serviceIds', [])
          && (sched.size() == 0
              || (day != null && day.get('enabled', false) == true
                  && day.open <= d.startTime && d.endTime <= day.close));
    }

    function aptCreateOk(aptId) {
      let d = request.resource.data;
      let company = companyDoc(d.companyId).data;
      return aptCreateShapeOk(d)
          && company.isActive == true
          && aptHasLock(aptId, d)
          && (
            // Dueño de la empresa: citas manuales o propias, pending/scheduled, sin atribuir a otro cliente
            (isAuth() && company.ownerId == request.auth.uid
              && d.status in ['pending', 'scheduled']
              && (!('clientId' in d) || d.clientId == request.auth.uid))
            // Cliente logueado o invitado: reserva desde la app
            || (d.source == 'app'
              && (!('staffId' in d) || aptStaffOk(d))
              && (d.status == 'pending' || (d.status == 'scheduled' && company.get('autoConfirm', false) == true))
              && (('clientId' in d)
                    ? (isAuth() && d.clientId == request.auth.uid && d.isGuestClient == false)
                    : d.isGuestClient == true))
          );
    }

    // Motivo de cancelación (opcional): sólo se escribe al pasar a 'cancelled', string de hasta 300.
    function cancelReasonOk() {
      return !changedKeys().hasAny(['cancelReason'])
          || (resource.data.status != 'cancelled'
              && request.resource.data.status == 'cancelled'
              && request.resource.data.cancelReason is string
              && request.resource.data.cancelReason.size() <= 300);
    }

    function ownerAptUpdateOk() {
      let s0 = resource.data.status;
      let s1 = request.resource.data.status;
      return changedKeys().hasOnly(['status', 'cancelledBy', 'cancelReason', 'updatedAt'])
          && cancelReasonOk()
          && request.resource.data.get('updatedAt', request.time) == request.time
          && (s0 == s1
              || (s0 == 'pending'   && s1 in ['scheduled', 'completed', 'cancelled'])
              || (s0 == 'scheduled' && s1 in ['completed', 'cancelled']))
          && (s1 != 'cancelled' || request.resource.data.get('cancelledBy', 'company') in ['company', 'client']);
    }

    function clientAptUpdateOk() {
      return request.resource.data.get('updatedAt', request.time) == request.time
          && (
            // Cancelar su propia cita activa
            (changedKeys().hasOnly(['status', 'cancelledBy', 'cancelReason', 'updatedAt'])
              && cancelReasonOk()
              && resource.data.status in ['pending', 'scheduled']
              && request.resource.data.status == 'cancelled'
              && request.resource.data.cancelledBy == 'client')
            // Ocultarla de su historial (no se borra: alimenta estadísticas de la empresa)
            || (changedKeys().hasOnly(['hiddenByClient', 'updatedAt'])
              && request.resource.data.hiddenByClient == true
              && resource.data.status in ['completed', 'cancelled'])
          );
    }

    match /appointments/{appointmentId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid
        || isCompanyOwner(resource.data.companyId)
        || isSuperAdmin()
      );
      allow create: if aptCreateOk(appointmentId);
      allow update: if isAuth() && (
        (isCompanyOwner(resource.data.companyId) && ownerAptUpdateOk())
        || (resource.data.get('clientId', null) == request.auth.uid && clientAptUpdateOk())
        || isSuperAdmin()
      );
      allow delete: if isAuth() && (
        (resource.data.get('clientId', null) == request.auth.uid && resource.data.status == 'cancelled')
        || isCompanyOwner(resource.data.companyId)
        || isSuperAdmin()
      );
    }

    // ───────────────────────── REVIEWS ─────────────────────────
    // Una reseña por cita: id del doc == appointmentId; la cita debe ser del cliente y estar completada.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.keys().hasAll(['companyId', 'clientId', 'clientName', 'rating',
                                                'comment', 'createdAt', 'appointmentId'])
        && request.resource.data.keys().hasOnly(['companyId', 'clientId', 'clientName', 'clientPhotoUrl',
                                                 'rating', 'comment', 'createdAt', 'appointmentId'])
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.clientName is string && request.resource.data.clientName.size() <= 120
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 2000
        && request.resource.data.createdAt is number
        && request.resource.data.appointmentId == reviewId
        && get(/databases/$(database)/documents/appointments/$(reviewId)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/appointments/$(reviewId)).data.companyId == request.resource.data.companyId
        && get(/databases/$(database)/documents/appointments/$(reviewId)).data.status == 'completed';
      allow update: if isSuperAdmin()
        || (isAuth()
            && changedKeys().hasOnly(['reply', 'replyAt'])
            && request.resource.data.reply is string && request.resource.data.reply.size() <= 2000
            && isCompanyOwner(resource.data.companyId))
        || (isAuth()
            && resource.data.clientId == request.auth.uid
            && changedKeys().hasOnly(['rating', 'comment', 'updatedAt'])
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
            && request.resource.data.comment is string && request.resource.data.comment.size() <= 2000);
      allow delete: if isSuperAdmin()
        || (isAuth() && resource.data.clientId == request.auth.uid);
    }

    // ───────────────────────── CONFIG ─────────────────────────
    // config/app: configuración global que edita el superadmin (planes, tiempos, contacto, anuncio, legal).
    // La leen todos (también páginas públicas sin login); sólo el superadmin escribe.
    function appConfigPath() { return /databases/$(database)/documents/config/app; }
    function optIntIn(d, key, lo, hi) {
      return !(key in d) || (d[key] is int && d[key] >= lo && d[key] <= hi);
    }
    function optMap(d, key) { return !(key in d) || d[key] is map; }
    // legal: { terms, privacy, updatedAt? } — textos de Términos y Política de datos (máx. 50.000 c/u)
    function validLegal(d) {
      return !('legal' in d) || (
        d.legal is map
        && d.legal.keys().hasOnly(['terms', 'privacy', 'updatedAt'])
        && optString(d.legal, 'terms', 50000)
        && optString(d.legal, 'privacy', 50000)
        && (!('updatedAt' in d.legal) || d.legal.updatedAt is timestamp)
      );
    }
    function validAppConfig(d) {
      return optIntIn(d, 'trialMonths', 1, 12)
        && optIntIn(d, 'warningDays', 0, 30)
        && optIntIn(d, 'graceDays', 0, 30)
        && optMap(d, 'plans') && optMap(d, 'support') && optMap(d, 'announcement')
        && validLegal(d);
    }
    // Tope del trial que crea el dueño: trialMonths*31+1 días (2 meses = 63, el valor histórico).
    // exists() antes de get(): get() de un doc inexistente hace fallar la regla.
    function trialMaxDays() {
      return exists(appConfigPath())
        ? get(appConfigPath()).data.get('trialMonths', 2) * 31 + 1
        : 63;
    }

    match /config/{docId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() && (docId != 'app' || validAppConfig(request.resource.data));
      allow delete: if isSuperAdmin();
    }

    // ───────────────────────── SUBSCRIPTIONS ─────────────────────────
    // Sin Functions el trial lo crea el dueño en el onboarding, UNA vez (create sólo aplica si no existe).
    // Forma exacta (= functions/src/subscriptions/on-company-created.ts):
    //   { companyId == docId, status: 'trial', trialStartDate: serverTimestamp(), trialEndDate: Timestamp }
    match /subscriptions/{companyId} {
      allow read:   if isCompanyOwner(companyId) || isSuperAdmin();
      allow create: if isSuperAdmin() || (
        isCompanyOwner(companyId)
        && request.resource.data.keys().hasOnly(['companyId', 'status', 'trialStartDate', 'trialEndDate'])
        && request.resource.data.keys().hasAll(['companyId', 'status', 'trialStartDate', 'trialEndDate'])
        && request.resource.data.companyId == companyId
        && request.resource.data.status == 'trial'
        && request.resource.data.trialStartDate is timestamp
        && request.resource.data.trialStartDate > request.time - duration.value(1, 'd')
        && request.resource.data.trialStartDate < request.time + duration.value(1, 'd')
        && request.resource.data.trialEndDate is timestamp
        && request.resource.data.trialEndDate > request.time
        && request.resource.data.trialEndDate <= request.time + duration.value(trialMaxDays(), 'd')
      );
      allow update, delete: if isSuperAdmin();
    }

    // ───────────────────────── PAYMENTS ─────────────────────────
    match /payments/{paymentId} {
      allow read:  if isSuperAdmin() || (isAuth() && isCompanyOwner(resource.data.companyId));
      allow write: if isSuperAdmin();
    }

    // ───────────────────────── PAYMENT CLAIMS ─────────────────────────
    // La empresa reporta "pagué con la transacción X" al volver de Wompi. NO activa nada:
    // el admin verifica contra Wompi y registra el pago. Id del doc = id de la transacción
    // (un mismo pago no se reporta dos veces: un segundo create sería update → denegado).
    match /paymentClaims/{txId} {
      // resource == null: la empresa consulta si su transacción ya fue reportada antes de crear
      allow read: if isAuth() && (resource == null
                                  || isCompanyOwner(resource.data.companyId)
                                  || isSuperAdmin());
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['companyId', 'companyName', 'ownerEmail',
                                                 'transactionId', 'status', 'createdAt',
                                                 // Copia de lo que informó Wompi, SÓLO para mostrar:
                                                 // el admin vuelve a consultar a Wompi antes de activar.
                                                 'amount', 'plan', 'payerName', 'payerEmail',
                                                 'payerPhone', 'paymentMethod', 'paidAt'])
        && (!('amount' in request.resource.data) || (request.resource.data.amount is number
              && request.resource.data.amount >= 0 && request.resource.data.amount <= 100000000))
        && optString(request.resource.data, 'plan', 20)
        && optString(request.resource.data, 'payerName', 200)
        && optString(request.resource.data, 'payerEmail', 200)
        && optString(request.resource.data, 'payerPhone', 40)
        && optString(request.resource.data, 'paymentMethod', 40)
        && optString(request.resource.data, 'paidAt', 40)
        && request.resource.data.keys().hasAll(['companyId', 'companyName', 'ownerEmail',
                                                'transactionId', 'status', 'createdAt'])
        && request.resource.data.transactionId == txId
        && txId.matches('^[0-9A-Za-z-]{5,64}$')
        && request.resource.data.companyId is string
        && isCompanyOwner(request.resource.data.companyId)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.companyName is string && request.resource.data.companyName.size() <= 200
        && request.resource.data.ownerEmail is string && request.resource.data.ownerEmail.size() <= 200;
      allow update, delete: if isSuperAdmin();
    }

    // ───────────────────────── PAYMENT ATTEMPTS ─────────────────────────
    // La empresa tocó "Pagar": si nunca vuelve de Wompi, el admin ve el intento y sabe qué buscar.
    // No activa nada; sólo el admin lo descarta.
    match /paymentAttempts/{attemptId} {
      allow read: if isSuperAdmin() || (isAuth() && isCompanyOwner(resource.data.companyId));
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['companyId', 'companyName', 'plan', 'amount', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['companyId', 'companyName', 'plan', 'amount', 'status', 'createdAt'])
        && request.resource.data.companyId is string
        && isCompanyOwner(request.resource.data.companyId)
        && request.resource.data.companyName is string && request.resource.data.companyName.size() <= 200
        && request.resource.data.plan in ['mensual', 'semestral']
        && request.resource.data.amount is number
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isSuperAdmin();
    }

    // ───────────────────────── NOTIFICATIONS ─────────────────────────
    // Sólo usuarios autenticados, tipos conocidos, claves fijas y senderId == uid.
    // (Una reserva de invitado no genera notificación: aceptado.)
    match /notifications/{notifId} {
      allow read: if isAuth() && (
        resource.data.recipientId == request.auth.uid || isSuperAdmin()
      );
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['recipientId', 'type', 'title', 'body', 'link',
                                                 'read', 'createdAt', 'senderId'])
        && request.resource.data.keys().hasAll(['recipientId', 'type', 'title', 'body',
                                                'read', 'createdAt', 'senderId'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId.size() > 0 && request.resource.data.recipientId.size() <= 128
        && request.resource.data.type in ['new_appointment', 'appointment_confirmed', 'appointment_cancelled',
                                          'new_review', 'new_company', 'plan_changed',
                                          'payment_initiated', 'new_message']
        // Bandeja 'admin' sólo para avisos de alta de empresa / pago iniciado
        && ((request.resource.data.recipientId == 'admin')
              == (request.resource.data.type in ['new_company', 'payment_initiated']))
        && (request.resource.data.type != 'plan_changed' || isSuperAdmin())
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.body is string && request.resource.data.body.size() <= 1000
        && optString(request.resource.data, 'link', 500)
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow update: if isSuperAdmin() || (
        isAuth() && resource.data.recipientId == request.auth.uid
        && changedKeys().hasOnly(['read'])
        && request.resource.data.read == true
      );
      allow delete: if isSuperAdmin();
    }

    // ───────────────────────── MESSAGES ─────────────────────────
    function isMsgAuthor() {
      return (resource.data.senderRole == 'client'  && resource.data.clientId == request.auth.uid)
          || (resource.data.senderRole == 'company' && isCompanyOwner(resource.data.companyId));
    }

    match /messages/{messageId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId)
      );
      allow create: if isAuth()
        && request.resource.data.keys().hasOnly(['companyId', 'companyName', 'clientId', 'clientName',
                                                 'senderRole', 'text', 'createdAt', 'read'])
        && request.resource.data.keys().hasAll(['companyId', 'clientId', 'senderRole', 'text', 'createdAt'])
        && request.resource.data.companyId is string
        && request.resource.data.clientId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && optString(request.resource.data, 'clientName', 120)
        && optString(request.resource.data, 'companyName', 200)
        && request.resource.data.get('read', false) == false
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.senderRole == 'client'  && request.resource.data.clientId == request.auth.uid) ||
          (request.resource.data.senderRole == 'company' && isCompanyOwner(request.resource.data.companyId))
        );
      allow update: if isAuth() && (
        // Marcar como leído (cualquiera de las dos partes)
        (changedKeys().hasOnly(['read'])
          && request.resource.data.read == true
          && (resource.data.clientId == request.auth.uid || isCompanyOwner(resource.data.companyId)))
        // Editar mensaje propio no borrado (solo texto)
        || (changedKeys().hasOnly(['text', 'edited', 'editedAt'])
          && resource.data.get('deleted', false) != true
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.edited == true
          && isMsgAuthor())
        // Borrar mensaje propio (soft delete: deleted=true y texto vacío)
        || (changedKeys().hasOnly(['deleted', 'text'])
          && resource.data.get('deleted', false) != true
          && request.resource.data.deleted == true
          && request.resource.data.text == ''
          && isMsgAuthor())
      );
      // Borrar conversación: cualquiera de las dos partes
      allow delete: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId)
      );
    }
  }
}
