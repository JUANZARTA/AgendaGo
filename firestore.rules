rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }

    // Roles viven en Firestore users/{uid}.role, no en custom claims
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isSuperAdmin() { return isAuth() && userRole() == 'superadmin'; }
    function isCompany()    { return isAuth() && userRole() == 'company'; }
    function isOwner(uid)   { return isAuth() && request.auth.uid == uid; }

    function isCompanyOwner(companyId) {
      return isAuth() && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }

    // USERS
    match /users/{uid} {
      allow read:   if isOwner(uid) || isSuperAdmin();
      allow create: if isOwner(uid) && request.resource.data.role in ['client', 'company'];
      allow update: if isSuperAdmin() ||
        (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
        (isOwner(uid) && !resource.data.keys().hasAny(['role']) && request.resource.data.role in ['client', 'company']);
      allow delete: if isSuperAdmin();
    }

    // COMPANIES
    match /companies/{companyId} {
      allow read: if resource.data.isPublic == true
                  || (isAuth() && request.auth.uid == resource.data.ownerId)
                  || isCompanyOwner(companyId)
                  || isSuperAdmin();
      allow create: if isCompany() || isSuperAdmin();
      allow update: if isCompanyOwner(companyId) || isSuperAdmin() ||
        (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating', 'reviewCount']));
      allow delete: if isSuperAdmin();

      match /services/{serviceId} {
        allow read:  if true;
        allow write: if isCompanyOwner(companyId) || isSuperAdmin();
      }

      match /blockedSlots/{slotId} {
        allow read:  if true;
        allow write: if isCompanyOwner(companyId) || isSuperAdmin();
      }

      match /staff/{staffId} {
        allow read:  if true;
        allow write: if isCompanyOwner(companyId) || isSuperAdmin();
      }
    }

    // APPOINTMENTS
    match /appointments/{appointmentId} {
      allow read:   if true;
      allow create: if true;
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // REVIEWS
    match /reviews/{reviewId} {
      allow read:   if true;
      allow create: if isAuth() && request.resource.data.clientId == request.auth.uid;
      // empresa responde (solo campos reply y replyAt)
      allow update: if isSuperAdmin() ||
        (isAuth() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'replyAt']) &&
         isCompanyOwner(resource.data.companyId));
      allow delete: if isSuperAdmin();
    }

    // SUBSCRIPTIONS
    match /subscriptions/{companyId} {
      allow read:  if isCompanyOwner(companyId) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // NOTIFICATIONS
    match /notifications/{notifId} {
      allow read: if isAuth() && (
        resource.data.recipientId == request.auth.uid || isSuperAdmin()
      );
      allow create: if true;
      allow update: if isAuth() && (
        resource.data.recipientId == request.auth.uid || isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // MESSAGES
    match /messages/{messageId} {
      allow read: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId)
      );
      allow create: if isAuth() && (
        (request.resource.data.senderRole == 'client'  && request.resource.data.clientId == request.auth.uid) ||
        (request.resource.data.senderRole == 'company' && isCompanyOwner(request.resource.data.companyId))
      );
      // Marcar como leído
      allow update: if isAuth() && (
        resource.data.clientId == request.auth.uid ||
        isCompanyOwner(resource.data.companyId)
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
  }
}
